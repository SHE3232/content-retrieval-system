  "narrative": {
    "northStar": "安静的研究案头",
    "overview": "让搜索像打开桌上的一盏灯：用户只需说出还记得的内容，相关资料和依据便清晰浮现，而系统本身退到背景。界面以搜索为视觉中心，以可信的资料目录语言呈现结果来源、命中片段和命中原因；索引维护与技术状态保持可达，但不主导首屏。视觉上保持现代 Material 3 产品界面，不把案头做成木纹、纸张或台灯插画。层次来自克制的表面明度变化、稳定留白和清晰排版。",
    "keyCharacteristics": ["搜索是首屏唯一视觉主角。", "轻量分层，默认表面安静，聚焦状态清晰。", "结果同时说明内容、来源与命中依据。", "系统字体、Material Icons 和一致的组件语法。", "WCAG 2.1 AA 与辅助技术支持均为基线。"],
    "rules": [
      {"name": "The One-Lamp Rule", "body": "研究钴蓝只用于主要操作、当前选择与焦点，不作为大面积装饰背景。", "section": "colors"},
      {"name": "The Quiet Variation Rule", "body": "通过相邻表面的明度差和极低色度变化避免纯色单调。", "section": "colors"},
      {"name": "The Read-First Rule", "body": "字体缩放到 200% 时允许布局重排，不允许截断关键操作、状态或命中说明。", "section": "typography"},
      {"name": "The Flat-at-Rest Rule", "body": "静止内容默认无装饰阴影；只有焦点、悬停或临时浮层可以短暂抬升。", "section": "elevation"}
    ],
    "dos": ["Do 让搜索输入在启动后的阅读顺序、焦点顺序和视觉层级中都处于首位。", "Do 在结果中同时展示文件名、命中片段、来源位置和命中原因。", "Do 保持 48px 触控目标、可见焦点、屏幕阅读器语义和完整键盘路径。"],
    "donts": ["Don't 做成完全单调的纯色界面。", "Don't 把产品塑造成需要用户理解技术基础设施的后台管理系统。", "Don't 以装饰或技术炫耀压过搜索任务。"]
  }
