{
  "schema_version": 1,
  "name": "week8-public-source",
  "include_root_files": [
    ".gitignore",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "LICENSE",
    "NOTICE",
    "PRODUCT.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "pytest.ini"
  ],
  "include_root_directories": [
    ".github",
    "backend",
    "conversion-tools",
    "datasets",
    "demo-data",
    "docs",
    "frontend",
    "model-tools",
    "models",
    "third_party",
    "tools"
  ],
  "exclude_globs": [
    "docs/superpowers/**",
    "docs/week*/submission/**",
    "docs/*.docx",
    "docs/*.zip",
    "docs/**/*.docx",
    "docs/**/*.zip",
    "**/.dart_tool/**",
    "**/.git/**",
    "**/.mypy_cache/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/build/**",
    "**/coverage/**",
    "tmp/**",
    "output/**",
    "outputs/**",
    "recordings/**",
    "models/**",
    "third_party/mobileclip-src/**",
    "**/*.db",
    "**/*.key",
    "**/*.log",
    "**/*.onnx",
    "**/*.pem",
    "**/*.safetensors",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.tflite"
  ],
  "allow_globs": [
    "models/model-manifest.example.json"
  ],
  "required_files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "backend/pyproject.toml",
    "backend/uv.lock",
    "frontend/pubspec.yaml",
    "frontend/pubspec.lock",
    "models/model-manifest.example.json",
    "tools/start-mvp.ps1",
    "tools/compliance/generate_license_inventory.py"
  ]
}
